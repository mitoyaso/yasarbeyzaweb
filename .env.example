# ==============================================================================
# YAŞAR & BEYZA AŞK GÜNLÜĞÜ - ÇEVRE DEĞİŞKENLERİ (.env)
# ==============================================================================
# KULLANIM: Bu dosyayı kopyalayıp adını ".env" olarak değiştirin, içindeki değerleri doldurun.
# NOT: .env dosyası asla github'a yüklenmez (.gitignore ile koruması altındadır).

# Supabase Kontrol Paneli -> Project Settings -> API kısmından bu bilgileri alabilirsiniz.
VITE_SUPABASE_URL=https://projeniz.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Eros için sunucu tarafı yapay zekâ sağlayıcısı. Anahtarları Vercel'de de tanımlayın.
# Sağlayıcılardan yalnızca seçtiğinizin anahtarını eklemeniz yeterli.
EROS_PROVIDER=openai
OPENAI_API_KEY=
# OpenAI modeli varsayılan olarak gpt-6-luna. İsterseniz model adını değiştirebilirsiniz.
# EROS_MODEL=gpt-6-luna
# DeepSeek veya Gemini kullanımı:
# EROS_PROVIDER=deepseek
DEEPSEEK_API_KEY=
# EROS_PROVIDER=gemini
GEMINI_API_KEY=
# İsteğe bağlı: varsayılan yasar@sevgunlugu.com,beyza@sevgunlugu.com listesini değiştirin.
# EROS_IZINLI_EPOSTALAR=yasar@sevgunlugu.com,beyza@sevgunlugu.com

# ==============================================================================
# GİRİŞ BİLGİLERİ ARTIK BURADA TUTULMAZ
# ==============================================================================
# Giriş sistemi Supabase Auth'a taşındı. Kullanıcı adı/şifre ön yüzde veya .env
# dosyasında TUTULMAZ; hesaplar Supabase panelinden yönetilir:
#
#   Supabase Panel -> Authentication -> Users
#
# Tanımlı olması gereken hesaplar (uygulama bu adreslere eşler):
#   yasar@sevgunlugu.com   ->  Ekranda "Yaşar"
#   beyza@sevgunlugu.com   ->  Ekranda "Beyza"
#
# Yeni hesap eklemek isterseniz hem panele ekleyin hem de
# src/lib/constants.js içindeki AUTH_ACCOUNTS listesini güncelleyin.
# ==============================================================================
